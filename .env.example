# Copy this file to .env for local development. Never commit .env.
# Values below are placeholders for a local-only, zero-cost Docker setup.

PROJECT_NAME=production-mlops-ticket-router
COMPOSE_PROJECT_NAME=production-mlops-ticket-router
APP_ENV=development
LOG_LEVEL=INFO
GLOBAL_RANDOM_SEED=42

# PostgreSQL: replace the local development password in your untracked .env.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ticket_router
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ticket_router
# Uncomment after the local PostgreSQL service is running and `alembic upgrade head` succeeds.
# Without DATABASE_URL the API uses a non-durable in-memory adapter for local demonstrations.
# DATABASE_URL=postgresql+psycopg://ticket_router:change-me-local-only@127.0.0.1:5432/ticket_router
DATABASE_REQUIRED=false

# MLflow uses a separate database in the same local PostgreSQL service.
MLFLOW_POSTGRES_DB=mlflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_ARTIFACT_ROOT=/mlartifacts
MLFLOW_WORKERS=1
MLFLOW_REGISTERED_MODEL_NAME=ticket-router
MLFLOW_MODEL_ALIAS=champion

# Prefect is self-hosted locally and uses its own database in PostgreSQL.
PREFECT_POSTGRES_DB=prefect
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_UI_API_URL=http://127.0.0.1:4200/api
PREFECT_WORK_POOL_NAME=ticket-router-local
PREFECT_SERVER_ANALYTICS_ENABLED=false

# Local service URLs and ports.
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
API_CONFIDENCE_WARNING_THRESHOLD=0.50
API_DEFAULT_TOP_K=3
API_MAXIMUM_BATCH_SIZE=100
API_MAXIMUM_SUBJECT_CHARACTERS=2000
API_MAXIMUM_BODY_CHARACTERS=20000
API_MINIMUM_USABLE_CHARACTERS=1
DASHBOARD_API_URL=http://127.0.0.1:8000
DASHBOARD_REQUEST_TIMEOUT_SECONDS=10
STREAMLIT_PORT=8501
MLFLOW_PORT=5000
PREFECT_PORT=4200
SMOKE_READY_TIMEOUT_SECONDS=120

# Privacy-safe defaults. Raw subject/body text is never persisted by the Stage 9 schema.
STORE_RAW_TICKET_CONTENT=false
STORE_REDACTED_TICKET_TEXT=false
INPUT_HMAC_SECRET=replace-with-a-random-local-secret

# Batch monitoring uses DATABASE_URL and versioned thresholds in configs/monitoring.yaml.
# Optional CLI overrides select the lookback window, minimum event count, and model version.

# Dataset identity and revision are reproducibility settings in configs/base.yaml,
# not environment overrides.
