# Copy this file to .env for local development. Never commit .env.
# Values below are placeholders for a local-only, zero-cost Docker setup.

PROJECT_NAME=production-mlops-ticket-router
APP_ENV=development
LOG_LEVEL=INFO
GLOBAL_RANDOM_SEED=42

# PostgreSQL: replace the local development password in your untracked .env.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ticket_router
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ticket_router
DATABASE_URL=postgresql+psycopg://ticket_router:change-me-local-only@postgres:5432/ticket_router

# MLflow uses a separate database in the same local PostgreSQL service.
MLFLOW_POSTGRES_DB=mlflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=/mlartifacts
MLFLOW_REGISTERED_MODEL_NAME=ticket-router
MLFLOW_MODEL_ALIAS=champion

# Prefect is self-hosted locally and uses its own database in PostgreSQL.
PREFECT_POSTGRES_DB=prefect
PREFECT_API_URL=http://prefect-server:4200/api

# Local service URLs and ports.
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://api:8000
STREAMLIT_PORT=8501
MLFLOW_PORT=5000
PREFECT_PORT=4200

# Privacy-safe defaults. Raw subject/body text is not persisted by default.
STORE_RAW_TICKET_CONTENT=false
INPUT_HMAC_SECRET=replace-with-a-random-local-secret

# Ingestion must fail until implementation pins a full immutable Hub revision.
HF_DATASET_ID=Tobi-Bueck/customer-support-tickets
HF_DATASET_REVISION=PIN_FULL_COMMIT_SHA_BEFORE_INGESTION

